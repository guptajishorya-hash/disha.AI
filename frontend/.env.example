# NER-SmartRoute AI — Frontend Environment Variables
# Copy this file to .env.local for local development

# --- API Base URL ---
# For LOCAL development: leave empty or unset (Vite proxy handles it)
# VITE_API_BASE_URL=

# For PRODUCTION (Vercel): set this in Vercel dashboard -> Environment Variables
# Example value after deploying backend to Render:
VITE_API_BASE_URL=https://ner-smartroute-backend.onrender.com
